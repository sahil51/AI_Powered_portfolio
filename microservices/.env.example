# ==========================================
# Core App Settings
# ==========================================
ENVIRONMENT=development
DEBUG=true
APP_NAME="AI Executive Assistant"
APP_VERSION=1.0.0
LOG_LEVEL=INFO
LOG_JSON_FORMAT=true

# ==========================================
# Database Connection
# ==========================================
DB_NAME=ai_assistant
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5432

# ==========================================
# Redis Cache Settings
# ==========================================
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_SENTINEL_ENABLED=false
REDIS_SENTINEL_MASTER=mymaster
REDIS_SENTINEL_HOSTS=["127.0.0.1:26379"]
REDIS_SENTINEL_PASSWORD=""

# ==========================================
# Celery Queue Settings
# ==========================================
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2
CELERY_REDIS_SENTINEL_ENABLED=false

# ==========================================
# Security & JWT Authentication
# ==========================================
JWT_SECRET=super-secret-key-change-in-production
JWT_ALGORITHM=HS256
ENCRYPTION_ENABLED=false

# ==========================================
# LLM Providers (LiteLLM Compatible)
# ==========================================
LLM_PRIMARY_MODEL=gemini/gemini-2.5-flash
OPENAI_API_KEY=your-openai-api-key
EMBEDDING_MODEL=text-embedding-3-small

GEMINI_API_KEY=your-gemini-api-key

CEREBRAS_API_KEY=your-cerebras-api-key
CEREBRAS_MODEL=gpt-oss-120b

NVIDIA_API_KEY=your-nvidia-api-key
NVIDIA_MODEL=mistralai/mistral-nemotron

# ==========================================
# Observability, Tracing, and Telemetry
# ==========================================
SENTRY_DSN=""
OTLP_ENDPOINT=""
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

LANGSMITH_TRACING=false
LANGSMITH_API_KEY=""
LANGSMITH_PROJECT=po

# ==========================================
# Feature Flags & Limits
# ==========================================
ENABLE_AUDIT_LOGGING=true
ENABLE_RATE_LIMITING=true
ENABLE_CIRCUIT_BREAKERS=true
ENABLE_TRACING=true
ENABLE_METRICS=true
ENABLE_HEALTH_CHECKS=true

RATE_LIMIT_PER_MINUTE=30
MAX_TOOL_RETRIES=3
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_RESET_SECONDS=60
